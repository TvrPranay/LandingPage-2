# Frontend: public Razorpay Key ID only. Never expose the Secret in VITE_ variables.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Set the confirmed team registration fee in paise (e.g. ₹100 = 10000 paise).
# Keep this identical to REGISTRATION_FEE_PAISE below.
VITE_REGISTRATION_FEE_PAISE=0

# Server-only credentials and fee configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
REGISTRATION_FEE_PAISE=0
API_PORT=4242
APP_ORIGIN=http://localhost:5173
